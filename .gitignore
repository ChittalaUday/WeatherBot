# --- Runtime data ---------------------------------------------------------
# conversations.db is per-deployment chat history; export labels instead:
#   python -m backend.store --export data/from_users.csv
# The glob also covers the -wal/-shm siblings and the quarantine copy the store writes when
# the file fails its integrity check, each of which was ignored one exact path at a time.
data/conversations*.db*
data/processed/
data/from_users.csv

# Generated training data: 6 MB, byte-identical on every rebuild (fixed seeds).
#   python -m src.v4.dataset --build
# data/eval_v4.csv and ./v4_dataset.csv are hand-written and TRACKED - do not add them here.
data/v4_dataset.csv
# GeoNames dumps, re-downloaded on demand by src/fetch_locations.py
data/.geonames_cache/

