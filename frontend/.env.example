# Copy to .env.local. Next.js only exposes NEXT_PUBLIC_* to the browser, so everything the
# client needs has to be named that way - and nothing secret can go in this file.

# Where the backend is. Read in exactly one place: lib/utils.ts::apiUrl().
# Leave it unset for local development: the page falls back to its own hostname on :8787, so
# opening the app from a phone on the same network works without editing anything.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8787

# Optional. Read-aloud for an answer (components/messages.tsx). Unset hides the button.
NEXT_PUBLIC_TTS_URL=

# Optional. Streaming speech-to-text socket (docker compose up in stt-cpp/). Unset falls back
# to ws://<page hostname>:2701/v1/realtime, so a phone on the same LAN works without editing
# anything. The path matters - that port also serves the REST API, health and a playground.
NEXT_PUBLIC_STT_URL=ws://127.0.0.1:2701/v1/realtime
