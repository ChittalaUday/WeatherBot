# Copy to .env. Every variable below is read in exactly one place: backend/config.py.
# Existing environment always wins, so a real deployment sets these the normal way and the
# file changes nothing. All of them have working defaults - .env is for overrides and secrets.

# --- weather sources ------------------------------------------------------
GFS_API_URL=https://gfsapi.niruthiapptesting.com
GFS_HISTORICAL_URL=https://stg-gfs.niruthiapptesting.com
SOLR_URL=https://solr.apps.niruthi.com
INFEST_SERVER_URL=https://infestserver.apps.niruthi.com
# SECRET. The Basic-auth header the location index expects. There is a working value compiled
# into backend/config.py as a default - that is a credential in source and should be moved
# here and rotated.
SOLR_AUTH_HEADER=
HTTP_TIMEOUT=20
HTTP_CONNECT_TIMEOUT=10

# --- archive (internal network only) --------------------------------------
# SECRET. Never sent to a client. Without the key the query planner refuses dates older than
# the 7-day GFS lookback up front, rather than after a timeout.
ZARR_URL=http://172.16.16.111:8550
ZARR_API_KEY=

# --- generation: the local model that words every reply -------------------
#   ollama pull qwen3:0.6b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:0.6b
OLLAMA_TIMEOUT=20

# --- hosted NLU: Model 3, the third column in compare mode ----------------
# SECRET. Without it the compare view shows two columns and says why the third is missing.
AI_BASE_URL=https://integrate.api.nvidia.com/v1
API_KEY=
AI_MODEL=z-ai/glm-5.2
AI_TIMEOUT=45

# --- serving --------------------------------------------------------------
DEFAULT_MODEL=v4
# Comma-separated origins, or * for any.
CORS_ORIGINS=*
# Below MIN_CONFIDENCE a fragment inherits the previous turn's reading instead of adopting its
# own; below CONFIDENT an answer is still given but flagged for review. Re-run the calibration
# after every retrain rather than trusting these forever.
MIN_CONFIDENCE=0.45
CONFIDENT=0.95
# Rows one answer may carry back - a limit on what the aggregator, chart and reply can use.
MAX_ROWS=400

# --- offline only: src/fetch_locations.py samples place names from Postgres
DB_HOST=
DB_PORT=5433
DB_USER=
DB_PASSWORD=
DB_NAME=
